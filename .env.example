# Copy this file to `.env` and fill in your key.
# Get a free key at https://console.groq.com
# These can also be provided via `.streamlit/secrets.toml` (which is git-ignored).
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the default model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — generation controls
# GROQ_MAX_TOKENS=8192
# GROQ_TEMPERATURE=0.7
# Reasoning effort for gpt-oss models: low | medium | high (or "off" to omit)
# GROQ_REASONING_EFFORT=low
